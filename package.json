{
  "name": "namou-commerce",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/api"
  ],
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,magenta --kill-others --kill-others-on-fail \"npm run dev -w namou-web\" \"npm run dev -w namou-api\"",
    "dev:api": "npm run dev -w namou-api",
    "seed": "npm run seed -w namou-api",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint . && prettier --check .",
    "test": "npm run test --workspaces --if-present",
    "images:fetch": "npm run images:fetch -w namou-web",
    "images:upload": "npm run images:upload -w namou-web"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "prettier": "^3.6.2",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.44.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
