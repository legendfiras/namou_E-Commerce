# Optional. The API already returns absolute image URLs for uploaded photos.
# Relative local paths stay on the storefront unless this public prefix is set.
VITE_R2_PUBLIC_URL=

# Google Identity Services web client ID. Public. Must match GOOGLE_CLIENT_ID.
# Set this on Vercel before the production build. Do not put a client secret here.
VITE_GOOGLE_CLIENT_ID=

# The storefront keeps calling same-origin /api. Locally, Vite proxies that to
# the API. On Vercel, set API_ORIGIN (no VITE_ prefix) to the Render origin,
# such as https://your-service.onrender.com, with no trailing slash.
