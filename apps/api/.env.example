NODE_ENV=development
# Local only. Render injects PORT for the web service; do not set it there.
PORT=4000
MONGODB_URI=mongodb+srv://YOUR_USERNAME:YOUR_ENCODED_PASSWORD@YOUR_CLUSTER.mongodb.net/?appName=YOUR_APP
MONGODB_DB_NAME=namou_ecommerce
# Optional local DNS workaround for MongoDB SRV lookups. Leave empty to use the OS default.
DEV_DNS_SERVERS=

# Cloudflare R2 — used only by the image upload script, not by the running API.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Google Identity Services web client ID. Must match VITE_GOOGLE_CLIENT_ID.
# This is the OAuth client ID, not a client secret.
GOOGLE_CLIENT_ID=

# Signs the HttpOnly session cookie. Use a random string of at least 32 characters.
SESSION_SECRET=
