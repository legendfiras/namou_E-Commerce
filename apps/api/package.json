{
  "name": "namou-api",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "seed": "tsx src/seed.ts",
    "migrate-iphone-images": "tsx src/migrateIphoneImages.ts",
    "upload-images": "tsx scripts/uploadImages.ts",
    "typecheck": "tsc --noEmit",
